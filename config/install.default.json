{
  "schema_version": 1,
  "profile": "gentoo-amd64-openrc",
  "boot_mode": "uefi",
  "partition_table": "gpt",
  "disk": "/dev/sda",
  "disk_must_be_erased": false,
  "target_is_disposable": false,
  "disk_erase_authorized": false,
  "partition_layout": [
    {
      "device": "/dev/sda1",
      "size_mib": 512,
      "type": "efi-system",
      "filesystem": "vfat",
      "mount": "/boot"
    },
    {
      "device": "/dev/sda2",
      "size_mib": 2048,
      "type": "linux-swap",
      "mount": null
    },
    {
      "device": "/dev/sda3",
      "size": "remaining",
      "type": "linux-root",
      "filesystem": "ext4",
      "mount": "/"
    }
  ],
  "root_filesystem": "ext4",
  "swap_mb": 2048,
  "bootloader": "grub",
  "init_system": "openrc",
  "hostname": "gentoo",
  "timezone": "Europe/Prague",
  "network_method": "dhcp",
  "create_user": true,
  "username": "bajt",
  "install_user_ssh_key": true,
  "user_groups": [
    "wheel"
  ],
  "user_shell": "/bin/bash",
  "set_root_password": true,
  "allow_root_password_ssh": false,
  "password_source": "environment",
  "generate_missing_passwords": true,
  "root_password_env": "printadmin",
  "user_password_env": "bajtfaskoadmin",
  "execution_enabled": false,
  "review_status": "pending_operator_review"
}
