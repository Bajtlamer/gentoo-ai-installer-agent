{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyWrite": ["./approvals", "./plans", "./runs", "./secrets", "./config", "./inventory", "./.mcp.json", "./.claude"],
      "denyRead": ["./secrets", "./runs"]
    }
  },
  "permissions": {
    "deny": [
      "Read(/secrets/**)",
      "Read(/runs/*/credentials.json)",
      "Read(/runs/*/.credentials.*)",
      "Edit(/approvals/**)",
      "Edit(/plans/**)",
      "Edit(/runs/**)",
      "Edit(/secrets/**)",
      "Edit(/config/**)",
      "Edit(/inventory/**)",
      "Edit(/.mcp.json)",
      "Edit(/.claude/**)",
      "Bash(gentoo-agent approve:*)",
      "Bash(python -m gentoo_agent approve:*)",
      "Bash(python3 -m gentoo_agent approve:*)"
    ]
  }
}
